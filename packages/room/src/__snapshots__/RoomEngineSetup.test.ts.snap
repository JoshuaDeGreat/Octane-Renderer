exports[`RoomEngine room instance setup > masks every door and publishes the position of the ones facing 90 or 180 > door 0 1`] = `
{
  "log": [
    "createRoomInstance room_5",
    "create -1 room 0",
    "instance.setValue room_is_public 0",
    "instance.setValue room_z_scale 1",
    "instance.setValue room_min_x 1",
    "instance.setValue room_max_x 12",
    "instance.setValue room_min_y 2",
    "instance.setValue room_max_y 9",
    "object.setValue room_random_seed 77882",
    "logic.initialize {"dimensions":{"minX":1,"maxX":12,"minY":2,"maxY":9},"doors":[{"x":3,"y":4,"z":1,"dir":0}]}",
    "logic.process ObjectRoomMaskUpdateMessage {"_location":null,"_direction":null,"_type":"RORMUM_ADD_MASK","_maskId":"door_0","_maskType":"door","_maskLocation":{"_x":3,"_y":4,"_z":1,"_length":null},"_maskCategory":"hole"}",
    "create -2 tile_cursor 200",
  ],
  "returned": "instance",
}
`;

