exports[`RoomEngine room instance setup > masks every door and publishes the position of the ones facing 90 or 180 > several doors 1`] = `
{
  "log": [
    "createRoomInstance room_5",
    "create -1 room 0",
    "instance.setValue room_is_public 0",
    "instance.setValue room_z_scale 1",
    "instance.setValue room_min_x 1",
    "instance.setValue room_max_x 12",
    "instance.setValue room_min_y 2",
    "instance.setValue room_max_y 9",
    "object.setValue room_random_seed 77882",
    "logic.initialize {"dimensions":{"minX":1,"maxX":12,"minY":2,"maxY":9},"doors":[{"x":1,"y":1,"z":0,"dir":90},null,{"x":2,"y":6,"z":2,"dir":180},{"x":5,"y":5,"z":0,"dir":270}]}",
    "logic.process ObjectRoomMaskUpdateMessage {"_location":null,"_direction":null,"_type":"RORMUM_ADD_MASK","_maskId":"door_0","_maskType":"door","_maskLocation":{"_x":1,"_y":1,"_z":0,"_length":null},"_maskCategory":"hole"}",
    "instance.setValue room_door_x 0.5",
    "instance.setValue room_door_y 1",
    "instance.setValue room_door_z 0",
    "instance.setValue room_door_dir 90",
    "logic.process ObjectRoomMaskUpdateMessage {"_location":null,"_direction":null,"_type":"RORMUM_ADD_MASK","_maskId":"door_2","_maskType":"door","_maskLocation":{"_x":2,"_y":6,"_z":2,"_length":null},"_maskCategory":"hole"}",
    "instance.setValue room_door_x 2",
    "instance.setValue room_door_y 5.5",
    "instance.setValue room_door_z 2",
    "instance.setValue room_door_dir 180",
    "logic.process ObjectRoomMaskUpdateMessage {"_location":null,"_direction":null,"_type":"RORMUM_ADD_MASK","_maskId":"door_3","_maskType":"door","_maskLocation":{"_x":5,"_y":5,"_z":0,"_length":null},"_maskCategory":"hole"}",
    "create -2 tile_cursor 200",
  ],
  "returned": "instance",
}
`;

